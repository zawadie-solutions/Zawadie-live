{
  "name": "google-review-monitor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Monitors Google reviews linked from Asana tasks and emails when a review disappears.",
  "scripts": {
    "start": "tsx src/index.ts",
    "migrate": "tsx src/cli/migrate.ts",
    "discover": "tsx src/cli/discover.ts",
    "discover-locations": "tsx src/cli/discoverLocations.ts",
    "check-month": "tsx src/cli/checkMonth.ts",
    "poc": "tsx src/cli/poc.ts",
    "dashboard": "tsx src/cli/dashboard.ts",
    "preview": "tsx src/cli/preview.ts",
    "run-once": "tsx src/cli/runOnce.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "express": "^4.22.3",
    "node-cron": "^3.0.3",
    "nodemailer": "^6.9.14",
    "pg": "^8.12.0",
    "pino": "^9.3.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.25",
    "@types/node": "^22.5.0",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^6.4.15",
    "@types/pg": "^8.11.6",
    "pg-mem": "^3.0.2",
    "tsx": "^4.17.0",
    "typescript": "^5.5.4",
    "vitest": "^2.0.5"
  }
}
