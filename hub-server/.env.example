# Zawadie Solutions Hub — consolidated local-dev config.
# In production (Hostinger), set these in hPanel's environment-variables UI
# instead of uploading a .env file.

PORT=3000

# Shared SSO signing secret — still used for the google-review-monitor proxy.
# A random one is auto-generated into hub-server/data/sso-secret.txt if unset.
ZAWADIE_SSO_SECRET=

# Auto-generated into hub-server/data/session-secret.txt if unset. Set this
# explicitly in production so a redeploy doesn't log everyone out.
SESSION_SECRET=

# google-review-monitor still runs as its own process; point at it here.
GOOGLE_REVIEW_MONITOR_URL=http://localhost:3002

# ---- Ombeni AI (mounted at /ombeni-ai) ------------------------------------
# Required — Ombeni AI's chat + meeting analysis run on this.
OPENAI_API_KEY=

# Optional for now — leave blank until you embed the real Monday.com API.
MONDAY_API_KEY=
MONDAY_BOARD_ID=

# Optional for now — leave blank until you embed the real Slack app/bot.
SLACK_BOT_TOKEN=
SLACK_CHANNEL=

# Google Sign-In for Ombeni's "Connect Calendar" flow (not the hub login).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/ombeni-ai/auth/google/callback
GOOGLE_ALLOWED_DOMAIN=zawadie.com

# ---- Prompt Engineering (mounted at /prompt-engineering) ------------------
# External Neon Postgres connection string (unchanged from its Vercel setup).
DATABASE_URL=
